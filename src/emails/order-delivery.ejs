<main style="margin: 0; padding: 24px; background: #f4f6f8; font-family: Arial, Helvetica, sans-serif;">
  <section style="max-width: 600px; margin: 0 auto; background: #ffffff; border: 1px solid #e6eaef; border-radius: 14px; overflow: hidden;">
    <div style="padding: 22px 24px; border-bottom: 1px solid #eef1f4;">
      <p style="margin: 0; color: #1f2937; font-size: 13px; letter-spacing: 0.3px; text-transform: uppercase;">
        <%= brandName %>
      </p>
      <h1 style="margin: 8px 0 0; color: #111827; font-size: 22px; line-height: 1.3;">
        Your order is on the way
      </h1>
    </div>

    <div style="padding: 26px 24px 8px; color: #374151;">
      <p style="margin: 0 0 16px; font-size: 15px; line-height: 1.7;">
        Hi <strong><%= name %></strong>, your package has left our warehouse and is out for delivery.
      </p>

      <div style="background: #f9fafb; border: 1px solid #eef1f4; border-radius: 10px; padding: 14px 16px; margin: 0 0 22px;">
        <p style="margin: 0 0 6px; font-size: 13px; color: #6b7280;">Order code</p>
        <p style="margin: 0 0 12px; font-size: 16px; font-weight: 700; color: #111827;"><%= orderCode %></p>
        <p style="margin: 0 0 6px; font-size: 13px; color: #6b7280;">Order ID</p>
        <p style="margin: 0; font-size: 13px; color: #4b5563; word-break: break-all;"><%= orderId %></p>
      </div>

      <p style="margin: 0 0 18px; font-size: 14px; line-height: 1.7; color: #4b5563;">
        Once it arrives, confirm below so we can close out your delivery. You can also track this order anytime from your account.
      </p>

      <div style="text-align: center; margin: 8px 0 18px;">
        <a
          href="<%= confirmLink %>"
          style="display: inline-block; background: #111827; color: #ffffff; text-decoration: none; font-weight: 600; padding: 13px 24px; border-radius: 10px; font-size: 14px;"
        >
          Confirm I received my order
        </a>
      </div>

      <% if (typeof trackLink !== 'undefined' && trackLink) { %>
      <div style="text-align: center; margin: 0 0 20px;">
        <a href="<%= trackLink %>" style="color: #2563eb; font-size: 13px; text-decoration: none;">
          View order tracking
        </a>
      </div>
      <% } %>

      <p style="margin: 0 0 8px; font-size: 12px; color: #6b7280;">
        Button not working? Paste this link into your browser:
      </p>
      <p style="margin: 0 0 8px; font-size: 12px; line-height: 1.6; word-break: break-all; color: #2563eb;">
        <%= confirmLink %>
      </p>
    </div>

    <div style="padding: 16px 24px 22px; border-top: 1px solid #eef1f4; color: #9ca3af; font-size: 12px; text-align: center;">
      © <%= new Date().getFullYear() %> <%= brandName %>. All rights reserved.
    </div>
  </section>
</main>
